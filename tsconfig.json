{
    // Sources run directly on Node (type stripping), so only erasable syntax is allowed.
    // To switch to a build later: noEmit → false, add outDir; tsc rewrites ".ts" imports to ".js".
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2024"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "packages/*/src/**/*.ts",
        "packages/*/bin/**/*.ts",
        "packages/*/test/**/*.ts",
        "packages/*/test-live/**/*.ts",
        "*.config.ts"
    ]
}
